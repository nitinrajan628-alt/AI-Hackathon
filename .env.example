# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and must never be committed.

# ---------------------------------------------------------------------------
# THE SWITCH: choose which language-model provider the app uses.
#   gemini  - Google Gemini      (needs GEMINI_API_KEY)
#   openai  - OpenAI / ChatGPT   (needs OPENAI_API_KEY)
#   fake    - offline rule-based provider, no key and no network needed
# Change this one line and restart the app; nothing else needs to change.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Credentials (server-side secrets; never commit or log). Both may be set -
# only the selected provider's key is used.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional model overrides. Leave blank to use the per-provider defaults in
# config/llm.yaml (gemini-3.5-flash-lite / gpt-4.1-mini).
#   LLM_MODEL      overrides the model for whichever provider is selected
#   GEMINI_MODEL   overrides only the Gemini model
#   OPENAI_MODEL   overrides only the OpenAI model
# LLM_MODEL=
# GEMINI_MODEL=
# OPENAI_MODEL=

# Optional tuning
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Development-only: retain raw model payloads in logs (default false)
LOG_MODEL_PAYLOADS=false
